# Copy this file to `.env` and fill in your key.

# Required. Get one at https://ai.bitcoin.com/api (or use any OpenAI-compatible key).
GPTDIFF_LLM_API_KEY=your-key-here

# Which AI to use. Some good choices on ai.bitcoin.com:
#   gemini-3-pro-preview
#   gpt-5.2
#   claude-opus-4-5-20251101:thinking
GPTDIFF_MODEL=gemini-3-pro-preview

# Optional. Change this to use OpenAI / OpenRouter / etc. directly.
#   OpenAI:     https://api.openai.com/v1/
#   OpenRouter: https://openrouter.ai/api/v1/
GPTDIFF_LLM_BASE_URL=https://ai.bitcoin.com/api/v1/
